{
  "name": "byhnex-ai",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "vars": {
    "OPENAI_MODEL": "gpt-5.4-mini",
    "ALLOWED_ORIGINS": "https://osvalt16.github.io,http://localhost:5173,http://127.0.0.1:5173"
  },
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": {"limit": 6, "period": 60}
  }]
}
